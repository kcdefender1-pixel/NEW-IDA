// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Each scan session
model Scan {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  status      String    @default("pending") // pending, scanning, analyzing, complete, error
  briefText   String?   // The full conversational brief IDA generates
  storyCount  Int       @default(0)
  stories     Story[]
  messages    ChatMessage[]
}

// Individual stories found during scans
model Story {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  scanId            String
  scan              Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // Source info
  title             String
  url               String    @unique
  source            String    // "KC Star", "KCUR", "KC Tenants IG", etc.
  sourceType        String    // "mainstream", "community", "government", "social"
  rawContent        String    // Original text/snippet
  publishedAt       DateTime?

  // IDA's analysis (generated by Claude)
  summary           String?
  strategicValue    String?   // "narrative_leadership", "power_building", "agitation", "audience_growth", "morale"
  relevanceScore    Int?      // 1-100
  abolitionistAngle String?   // How this connects to liberation framework
  framingAdvice     String?   // How Defender should frame vs mainstream
  competitiveEdge   String?   // Why Defender can cover this better
  timeUrgency       String?   // "immediate", "today", "this_week", "evergreen"
  suggestedWriter   String?   // Team member best suited

  // Tracking
  covered           Boolean   @default(false) // Did the team cover this?
  skipped           Boolean   @default(false)
  notes             String?   // Team notes on this story

  // Pattern linking
  tags              String?   // Comma-separated: "kcpd,violence,pattern"
  patternLinks      String?   // IDs of related stories for pattern detection
}

// Configured news sources
model Source {
  id          String    @id @default(cuid())
  name        String    // "Kansas City Star"
  url         String    // RSS feed URL or scrape target
  type        String    // "rss", "twitter", "instagram", "government", "web"
  category    String    // "mainstream", "community", "government", "social"
  active      Boolean   @default(true)
  lastScanned DateTime?
}

// Conversation history for chat interface
model ChatMessage {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  role      String    // "user" or "ida"
  content   String
  scanId    String?
  scan      Scan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)
}
